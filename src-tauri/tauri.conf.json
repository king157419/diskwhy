{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskWhy",
  "version": "0.1.0",
  "identifier": "com.diskwhy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DiskWhy — C 盘每一块都说清楚",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
